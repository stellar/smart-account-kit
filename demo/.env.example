# Smart Account Kit Demo Configuration
# Copy this file to .env and customize as needed

# Stellar Network Configuration
VITE_RPC_URL=https://soroban-testnet.stellar.org
VITE_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Uploaded WASM hashes (testnet and mainnet)
# Smart Account (stellar-accounts v0.8.0): c514d35ea67eaea9bfc1fb3327854c0c06111bc1ddebd4fe217c504c1004b9e1
# WebAuthn Verifier (1e513890): e63a030d0f1a1481e36059a4837c433083b33e704c1f9625b7314795b6d72b76
# Ed25519 Verifier (1e513890): 60e8798db610bdaf3370d39ebda56ee1dc2c15ce1c3a9e28b528bfa24a06b477
# Threshold Policy (v0.8.0): f72a11de6e2d5d2495d98fe61e04cd13544e64156a5a3be83ef8c2e403d14a94
# Spending Limit Policy (v0.8.0): 9bc17db0a804d6c82231a268c43bac1413650ea92cac0022e0d0a3b66ddc8189
# Weighted Threshold Policy (v0.8.0): 79b4e299c39c9bfb7a64d03c896b510cee382770714ac9b2f00ee2c9df4c5d13
#
# The demo also connects wallets on the earlier account builds:
# 1b5f4534a76322da2ad7c745f6900857a6802b0ca79850c35a03561df997785a (stellar-contracts@1e513890)
# 203e2970d9fed24fb5fca2e0aeebb3c1e4648b76dd6601567178e6474c9fec6f (stellar-accounts v0.7.3, upgrades only)
# See docs/deployments-stellar-accounts-0.8-2026-10-25.md.
#
# Smart Account Contract (WASM hash uploaded to network)
VITE_ACCOUNT_WASM_HASH=c514d35ea67eaea9bfc1fb3327854c0c06111bc1ddebd4fe217c504c1004b9e1

# Optional: use a deployed contract ID instead of a WASM hash when regenerating
# bindings against a specific smart account instance.
VITE_ACCOUNT_CONTRACT_ID=

# Verifier Contracts
VITE_WEBAUTHN_VERIFIER_ADDRESS=CC7EKIHQP3TN4CARQDND6CEOY2UXLWWC2X5GHTD5NLAT7BG5GPZIOM3F
VITE_ED25519_VERIFIER_ADDRESS=CAAVTMCBXEIBPR64EAASKFXERVPYFZA2JYP5A3BG6PESWEFUJX5IHKN4

# Native XLM Token Contract (SAC address)
VITE_NATIVE_TOKEN_CONTRACT=CDLZFC3SYJYDZT7K67VZ75HPJVIEUVNIXF47ZG2FB2RMQQVU2HHGCYSC

# Policy Contracts (stellar-accounts v0.8.0)
# Rules created before the v0.8.0 default keep the 1e513890 policies. The demo
# still reads and labels those policies, but offers only these for new rules.
# Threshold and spending-limit are enabled in the default demo.
# Weighted-threshold is optional; set it to expose that policy in the UI.
VITE_THRESHOLD_POLICY_ADDRESS=CAZ2WFUDXGX265LOEARFEOYYUL6F4BYWXZLGUAWZNJY3MRFPNLSZVS4S
VITE_SPENDING_LIMIT_POLICY_ADDRESS=CC3CEYQAP6NPNFIYSWL5MVZRCPJZGWX4XO7WDEJOUVGO2FZX5OONYPA5
VITE_WEIGHTED_THRESHOLD_POLICY_ADDRESS=CDBYLFLUNPAYGE3AHZSMB4TFWECFCCHX6CJFMFO6HRPKK2W5PFU2LCKE

# Contract discovery (optional)
# Leave blank to use the SDK's built-in testnet indexer.
# Mercury-compatible endpoint: https://testnet.mercurydata.app/rest/smart-account-indexer
# Browser builds expose VITE_* values, so only use a public or tightly scoped token here.
VITE_INDEXER_URL=
VITE_INDEXER_AUTH_TOKEN=

# Fee Sponsoring (Relayer)
# Transactions are POSTed to this relayer-proxy, which submits them through the
# OpenZeppelin Relayer Channels service — channel accounts pay the fees, your
# smart wallet pays none. This defaults to the deployed testnet proxy, so the
# demo is fee-sponsored out of the box. The shared default deployer is sign-only,
# so an empty value prevents direct submission. Use a matching proxy for another
# network. See ../relayer-proxy.
VITE_RELAYER_URL=https://smart-account-relayer-proxy.sdf-ecosystem.workers.dev
